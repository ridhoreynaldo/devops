# /opt/devops/.env — pengaturan global (bukan password; password per layer ada di <layer>/.env)
# cp .env.example .env

# Domain utama server (vhost ridhoreynaldo-com.conf). Kosongkan jika tidak dipakai.
PRIMARY_DOMAIN=ridhoreynaldo.com
# Email notifikasi kedaluwarsa sertifikat Let's Encrypt (disarankan diisi)
CERTBOT_EMAIL=
