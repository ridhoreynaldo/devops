# 01-infra/.env — password layer data. Di-generate otomatis oleh bootstrap.sh;
# salin manual hanya jika tidak memakai bootstrap:  cp .env.example .env
# Generate nilai acak:  openssl rand -base64 24
# File .env TIDAK BOLEH di-commit.

# superuser Postgres (hanya untuk admin/backup — aplikasi memakai user sendiri dari create-app-db.sh)
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_KUAT

# role rendah-hak yang dipakai PgBouncer untuk membaca verifier password (auth_query)
PGBOUNCER_AUTH_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_KUAT

# Redis cache (infra_redis) — boleh hilang
REDIS_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_KUAT

# Redis queue (infra_redis_queue) — antrian job, persisten
REDIS_QUEUE_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_KUAT

# SQL Server sa (min. 8 karakter, huruf besar/kecil/angka/simbol)
MSSQL_SA_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_KUAT

# 127.0.0.1 = port DB hanya dari server ini (default aman). 0.0.0.0 = terbuka ke publik (hindari).
BIND_IP=127.0.0.1
